# Скопіюйте у .env і заповніть реальними значеннями. .env НЕ комітиться в git.
# Серія: Practical AI Assistants (5 безкоштовних демо-ботів).

# --- AI Provider: "groq" або "kiro" ---
AI_PROVIDER=groq

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM через Kiro Gateway (OpenAI-сумісний ендпоінт) ---
KIRO_GATEWAY_URL=http://localhost:9000
KIRO_GATEWAY_API_KEY=your_kiro_gateway_api_key
KIRO_GATEWAY_MODEL=claude-haiku-4-5

# --- Матриця реальних даних у Google Sheets (джерело цін, наповнює скрейпер) ---
# Сервісний акаунт Google (JSON-ключ, НЕ комітиться в git) — як у Chatbot_whatsapp_faq.
# Один ключ використовують і боти (читання), і скрейпер (запис).
GOOGLE_CREDS_PATH=config/google-service-account.json
# ID за замовчуванням, якщо бот не задає власний sheet_id_env у knowledge.sheets
GOOGLE_SHEET_ID=

# --- Логування бесід у Google Sheets (окремий аркуш log_<bot_name> на бота) ---
# ОБОВ'ЯЗКОВЕ, увімкнено за замовчуванням. Той самий сервісний акаунт GOOGLE_CREDS_PATH.
# Ставити false лише для локального тесту.
DIALOG_LOG_ENABLED=true
# Таблиця для логів (якщо порожнє — використовується GOOGLE_SHEET_ID)
DIALOG_LOG_SHEET_ID=

# --- Загальні налаштування ---
BOTS_DIR=bots
DB_PATH=multibot.db
LOG_LEVEL=INFO

# --- Токени ботів (BotFather). Імена відповідають token_env у bots/*.yaml ---
BUILDING_BOT_TOKEN=
FURNITURE_BOT_TOKEN=
AUTO_BOT_TOKEN=
WINDOWS_BOT_TOKEN=
BEAUTY_BOT_TOKEN=

# --- Адмін-чат для команди /stats (у Telegram) ---
ADMIN_CHAT_ID=

# --- Admin-панель + CRM (веб, окремий процес; вимкнена за замовчуванням) ---
# CRM-розділ (booking) з'являється в тій самій панелі, коли booking увімкнено хоча б для 1 бота.
ADMIN_ENABLED=false
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8600
ADMIN_USERNAME=admin
# bcrypt-хеш пароля (НЕ сам пароль). Згенерувати: python -m admin hash-password
ADMIN_PASSWORD_HASH=
# Секрет для підпису сесійних cookie (випадковий довгий рядок)
ADMIN_SESSION_SECRET=change_this_to_a_long_random_string

# --- Booking (демо-запис) ---
# Вмикається в конфігу бота (booking.enabled: true); наразі лише beauty.
# Сповіщення про новий запис надсилаються в ADMIN_CHAT_ID (вище).
# Дані booking зберігаються у SQLite (DB_PATH). Нагадування за 2 год — поки відкладено.

# --- ID матриць у Google Sheets per-bot (sheet_id_env у knowledge.sheets) ---
# Якщо бот не задає власний — використовується GOOGLE_SHEET_ID за замовчуванням
BUILDING_SHEET_ID=
WINDOWS_SHEET_ID=
BEAUTY_SHEET_ID=
# FURNITURE_SHEET_ID / AUTO_SHEET_ID — за потреби (у демо матриця вимкнена)

# --- Опційні отримувачі лідів (sinks вимкнені за замовчуванням у конфігах) ---
# Увімкнути можна в bots/*.yaml (integrations.sinks[].enabled: true)
# BUILDING_MANAGER_CHAT_ID=
# FURNITURE_MANAGER_CHAT_ID=
# AUTO_MANAGER_CHAT_ID=
# WINDOWS_MANAGER_CHAT_ID=
# BEAUTY_MANAGER_CHAT_ID=
# CRM_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
