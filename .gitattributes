# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicitly LF for these types
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.service text eol=lf
*.env text eol=lf
*.example text eol=lf

# Binary files — no line ending conversion
*.db binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
